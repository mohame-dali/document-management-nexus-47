{
  "name": "dms-e2e-tests",
  "version": "1.0.0",
  "description": "Suite de tests automatisés E2E Playwright pour l'application DMS",
  "scripts": {
    "auth:setup": "playwright test tests/01_auth/login.spec.ts --project=setup",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:p0": "playwright test --grep @p0",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.6.0"
  }
}

