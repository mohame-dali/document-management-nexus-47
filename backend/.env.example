PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/document-management
JWT_SECRET=your_super_secret_key_here_change_in_production
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# ---- AI (node-llama-cpp) ----
# Chemins vers les modèles GGUF (absolus recommandés en production Ubuntu)
LLAMA_CHAT_MODEL_PATH=/opt/dms-models/qwen2.5-7b-instruct-q4_k_m.gguf
LLAMA_EMBEDDING_MODEL_PATH=/opt/dms-models/nomic-embed-text-v1.5.Q8_0.gguf

# Performance & Inférence
LLAMA_THREADS=4
LLAMA_GPU_LAYERS=0    # 0 = CPU only, >0 = GPU CUDA/Metal

# ---- Anciennes variables Ollama (Obsolètes - conservées pour rollback éventuel) ----
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen3.5:latest
# OLLAMA_FALLBACK_MODEL=qwen3.5:latest
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
