
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/document-management
JWT_SECRET=yoursecret
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30
DOCUMENT_PATH=courrier

# Scanner Configuration
SCANNER_ENABLED=true
SCANNER_DEVICE_ID=
SCANNER_RESOLUTION=300
SCANNER_FORMAT=PDF
UPLOAD_PATH=./uploads

# Advanced Scanner Options
SCANNER_SIMULATE=false  # Set to false to disable simulated scanners
SCANNER_DEBUG=false
SCANNER_OCR_ENABLED=true
SCANNER_AUTO_SELECT=true
SCANNER_TIMEOUT=60000
SCANNER_HISTORY_SIZE=10
