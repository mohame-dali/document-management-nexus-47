# ==============================================================================
# .env.production.example — Configuration de Production DMS (Serveur Local)
# ==============================================================================
# Usage :
#   1. Copier ce fichier vers .env : cp .env.production.example .env
#   2. Remplacer impérativement tous les placeholders "CHANGE_ME"
#   3. Restreindre les droits du fichier : chmod 600 .env (chown dms:dms .env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONNEMENT & SERVEUR WEB (PORT UNIQUE 3000)
# ------------------------------------------------------------------------------
NODE_ENV=production
# Le port interne sur lequel écoute server.ts (3000 partout)
PORT=3000

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES MONGODB
# ------------------------------------------------------------------------------
# IMPORTANT : Utiliser un compte d'application dédié créé avec des droits restreints
# Exemple de chaîne avec authentification locale :
# mongodb://<username>:<password>@127.0.0.1:27017/<dbname>?authSource=admin
MONGODB_URI=mongodb://dms_app_user:CHANGE_ME_MONGODB_PASSWORD@127.0.0.1:27017/document-management?authSource=admin

# ------------------------------------------------------------------------------
# 3. SÉCURITÉ AUTHENTIFICATION & JETONS JWT
# ------------------------------------------------------------------------------
# Clé secrète de signature JWT (OBLIGATOIRE - minimum 64 caractères hexadécimaux)
# Générer avec : node -e "console.log(crypto.randomBytes(48).toString('hex'))"
# ATTENTION : Ne JAMAIS utiliser 'votre_secret_super_securise_123' ni 'dms_dev_jwt_secret...'
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_64_CHARACTERS_HEX_SECRET

# Durée de validité du jeton d'authentification (ex: 8h pour une journée de travail)
JWT_EXPIRE=8h

# Durée de validité du cookie HTTP-only (en jours, ex: 1)
JWT_COOKIE_EXPIRE=1

# ------------------------------------------------------------------------------
# 4. SÉCURITÉ RÉSEAU & CORS (ORIGINES AUTORISÉES)
# ------------------------------------------------------------------------------
# Liste blanche des origines autorisées (séparées par une virgule, sans espace)
# Exemples : https://dms.local,https://courrier.administration.gov.tn,https://192.168.1.100
ALLOWED_ORIGINS=https://dms.local,https://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. CHEMINS DES RÉPERTOIRES DE DONNÉES (CHEMINS ABSOLUS CONSEILLÉS EN PRODUCTION)
# ------------------------------------------------------------------------------
# Répertoire racine de stockage des courriers PDF scannés et indexés
# Linux : /var/www/dms/backend/courrier
# Windows : C:\dms\backend\courrier
DOCUMENT_PATH=/var/www/dms/backend/courrier

# Répertoire racine des téléversements Multer (pièces jointes, photos, modèles)
# Linux : /var/www/dms/backend/uploads
# Windows : C:\dms\backend\uploads
UPLOAD_DIR=/var/www/dms/backend/uploads

# Répertoire cible pour les sauvegardes automatiques
# Linux : /var/backups/dms
# Windows : C:\backups\dms
BACKUP_DIR=/var/backups/dms

# ------------------------------------------------------------------------------
# 6. MODULE D'INTELLIGENCE ARTIFICIELLE LOCALE (GGUF / node-llama-cpp)
# ------------------------------------------------------------------------------
# Modèle de Chat & Synthèse (ALLaM 7B Instruct quantifié Q4_K_M)
LLAMA_CHAT_MODEL_PATH=/var/www/dms/models/ALLaM-AI_ALLaM-7B-Instruct-preview-Q4_K_M.gguf

# Modèle d'Embedding / Recherche vectorielle sémantique (BGE-M3 quantifié Q4_K_M)
LLAMA_EMBEDDING_MODEL_PATH=/var/www/dms/models/bge-m3-q4_k_m.gguf

# Nombre de cœurs physiques CPU dédiés (laisser vide pour détection automatique : cœurs / 2)
LLAMA_THREADS=4

# Nombre de couches GPU déchargées (0 = CPU pur pour serveur sans carte graphique, >0 si GPU Nvidia/Vulkan)
LLAMA_GPU_LAYERS=0

# Planification du rattrapage de réindexation IA vectorielle (format cron 5 champs)
INDEX_RETRY_CRON=0 2 * * *

# ------------------------------------------------------------------------------
# 7. PILOTAGE DU SCANNER LOCAL (OPTIONNEL)
# ------------------------------------------------------------------------------
SCANNER_ENABLED=false
# Identifiant du périphérique détecté (ex: panamfs:libusb:003:003 ou nom WIA)
SCANNER_DEVICE_ID=
SCANNER_RESOLUTION=300
SCANNER_FORMAT=pdf

# ------------------------------------------------------------------------------
# 8. CONFIGURATION DU PROXY SORTANT (SI SERVEUR D'ADMINISTRATION EN RÉSEAU FERMÉ)
# ------------------------------------------------------------------------------
# Laisser vide si le serveur n'a pas besoin de traverser un proxy d'entreprise
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.local
